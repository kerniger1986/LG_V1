# Datenbank (Neon Postgres, EU/Frankfurt-Region)
DATABASE_URL="postgresql://user:password@ep-xxxx-eu-central-1.aws.neon.tech/leadgen?sslmode=require"

# Admin-Login
ADMIN_EMAIL="kern@fscf-holding.de"
# Mit `npx tsx scripts/hash-password.ts <passwort>` erzeugen
ADMIN_PASSWORD_HASH=""

# NextAuth
# Generieren mit: npx auth secret   (oder: openssl rand -base64 32)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Slack-Benachrichtigung bei neuem Lead (Incoming Webhook)
# Erzeugen unter https://api.slack.com/apps -> App erstellen -> "Incoming Webhooks"
SLACK_WEBHOOK_URL=""

# Tracking (Platzhalter - erst eintragen, wenn Konten angelegt sind, siehe Checkliste)
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=""
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Telefonnummer fuer Klick-zum-Anrufen auf Homepage und Persona-Seiten.
# Leer lassen, dann wird der Anruf-Button einfach ausgeblendet.
NEXT_PUBLIC_CONTACT_PHONE=""

# Geschaeftsadresse fuer das Schema.org LocalBusiness-Markup (SEO).
# Alle drei Felder werden gebraucht, sonst bleibt das address-Feld einfach
# weg. Erst eintragen, wenn die echte Anschrift im Impressum steht.
NEXT_PUBLIC_BUSINESS_STREET=""
NEXT_PUBLIC_BUSINESS_PLZ=""
NEXT_PUBLIC_BUSINESS_ORT=""

# Google Places Autocomplete fuer das Adressfeld im Lead-Formular.
# Google Cloud Projekt -> "Places API" aktivieren -> API-Key erzeugen und
# per HTTP-Referrer auf die eigene Domain einschraenken.
# Leer lassen, dann bleibt das Adressfeld ein normales Textfeld.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Lead-Löschfrist in Monaten (fuer abgeschlossene/abgelehnte Leads, manuell ausgeloest im Admin)
LEAD_RETENTION_MONTHS=24

# Basis-URL fuer die Sitemap. Optional - ohne eigene Domain wird automatisch
# die Vercel-Adresse verwendet.
NEXT_PUBLIC_SITE_URL=""
